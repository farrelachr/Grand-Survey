# ==============================================================================
# GRAND SURVEY HIMALKOM 2026 — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in the appropriate credentials.
# ==============================================================================

# 1. APPLICATION URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. SUPABASE CREDENTIALS (Find in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. ALLOWED EMAIL DOMAINS (Comma-separated)
# Enforced on both server actions, API routes, and database triggers
ALLOWED_EMAIL_DOMAINS=apps.ipb.ac.id,ipb.ac.id

# 4. ADMINISTRATOR ACCOUNTS (Comma-separated)
# Emails in this list gain access to /admin and export capabilities
ADMIN_EMAILS=admin.himalkom@apps.ipb.ac.id,ketua.himalkom@apps.ipb.ac.id

# 5. GOOGLE SHEETS API INTEGRATION (Server-Side Service Account)
# Optional for development, mandatory for live automatic spreadsheet sync
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
# Format private key with escaped newlines (e.g. "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n")
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
